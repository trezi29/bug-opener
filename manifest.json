{
  "manifest_version": 3,
  "name": "Bug Opener",
  "version": "1.0.0",
  "description": "Report bugs directly from any webpage to Linear or ClickUp with annotated screenshots.",
  "permissions": ["activeTab", "tabs", "scripting", "storage"],
  "host_permissions": [
    "<all_urls>",
    "https://api.linear.app/*",
    "https://api.clickup.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "src/options/index.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
